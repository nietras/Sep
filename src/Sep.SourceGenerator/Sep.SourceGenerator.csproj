<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageId>Sep.SourceGenerator</PackageId>
    <Description>High-performance source generator for Sep CSV models.</Description>
    <PackageTags>sep;csv;source-generator;roslyn</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/nietras/Sep/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.8 is the Roslyn version hosted by the oldest supported .NET 8 SDK. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <!-- The analyzer itself only ships as netstandard2.0 and has no runtime Sep dependency, but the
         generated source calls Sep, so the package must declare Sep as a dependency. Sep has no
         netstandard2.0 asset, hence the extra net8.0 target framework carrying the dependency and
         defining the minimum Sep version whose APIs the generated source uses. -->
    <PackageReference Include="Sep" Version="0.15.1" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="AddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetTargetPath" Properties="TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SepAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_SepAnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Sep.SourceGenerator.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
