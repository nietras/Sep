<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The generator ships as its own package rather than inside the Sep package. Bundling is the
         more common pattern, see System.Text.Json and Microsoft.Extensions.Logging, but it makes
         the generator unavoidable: a generator injects its attributes into every compilation and is
         loaded and run by Roslyn even when unused. Sep is about not paying for what you do not use,
         so source generation is opt in and costs nothing for those who do not reference this. -->

    <!-- netstandard2.0 is what Roslyn loads and is the only assembly shipped in the package. The
         net8.0 target framework builds no code, it exists solely so the package can declare a
         net8.0 dependency group for Sep, see the Sep project reference below. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageId>Sep.SourceGenerator</PackageId>
    <Description>Source generator for Sep the World's Fastest .NET CSV Parser.</Description>
    <PackageTags>sep;csv;source-generator;roslyn</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/nietras/Sep/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- Compiling the generator for net8.0 too would waste build time on an assembly that is never
       shipped and that could be mistaken for the real analyzer, so net8.0 builds nothing. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- 4.8 is the Roslyn version hosted by the oldest supported .NET 8 SDK. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- The generated source calls Sep, so the package must declare Sep as a dependency, even
         though the analyzer assembly itself never references Sep. Sep targets net8.0 and later
         only, so it cannot be referenced from netstandard2.0 and the dependency has to live in a
         net8.0 dependency group. A project reference is used rather than a package reference so
         the dependency version always matches the Sep built from this repository, which MinVer
         derives from the git tag. Note ReferenceOutputAssembly must not be set to false here,
         since that also suppresses the nuspec dependency this reference exists to declare. -->
    <ProjectReference Include="..\Sep\Sep.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="AddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetTargetPath" Properties="TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SepAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_SepAnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Sep.SourceGenerator.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
